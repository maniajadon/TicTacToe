    private int runden = 0;
    
    public Spiel (int spieler, int runden){
        this.spieler = spieler;
        this.runden = runden;
        for(int x = 0; x < feld.length ; x++){
            for (int y = 0; y < feld.length ; y++){
                feld[x][y]= '?';
            }
        }
    }
    public void Ausgabe(){
